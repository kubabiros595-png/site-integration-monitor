        "jsCode": "// One test run = the scanner called 5 times in a row, once per simulated day, in the separate \"eval\" scope.\n// The eval scope has its own state rows, so tests never touch the live state.\nconst runId = 'EVAL-' + $now.setZone('Europe/Warsaw').toFormat('yyyyMMdd-HHmmss');\nreturn [1, 2, 3, 4, 5].map((day) => ({ json: { scope: 'eval', day, run_id: runId } }));\n"
      },
