        "language": "javaScript",
        "jsCode": "const rows = $('Compare expected vs actual').all().map((i) => i.json);\nconst count = (o) => rows.filter((r) => r.outcome === o).length;\nreturn [{ json: { run_id: rows[0] && rows[0].run_id, checkpoints: rows.length, passed: rows.filter((r) => r.passed).length,\n  missed: count('missed'), false_alarms: count('false alarm'), wrong_result: count('wrong result'),\n  failures: rows.filter((r) => !r.passed).map((r) => r.case_id + ': expected ' + r.expected + ', got ' + r.actual + ' (' + r.detail + ')') } }];\n"
