    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// 40 checkpoints (8 sites x 5 days). Expected answers were written before the first run (SIM Eval Cases).\n// missed = an alert was expected but none came; false alarm = an alert came when none was expected.\nconst runId = $('Days 1 to 5').first().json.run_id;\nconst log = $('Scan log of this run').all().map((i) => i.json).filter((r) => r.run_id === runId);\nconst cases = $input.all().map((i) => i.json).filter((c) => c.case_id);\nconst runAt = $now.setZone('Europe/Warsaw').toFormat('yyyy-MM-dd HH:mm');\nconst actualOf = (r) => (r.alert ? r.level : r.result === 'cannot_check' ? 'cannot_check' : 'none');\nconst isAlert = (v) => v === 'urgent' || v === 'high';\nreturn cases.sort((a, b) => a.case_id.localeCompare(b.case_id)).map((c) => {\n  const rows = log.filter((r) => r.site_id === c.site_id && Number(r.day) === Number(c.day));\n  const actual = rows.length === 1 ? actualOf(rows[0]) : rows.length === 0 ? 'no scan row' : rows.length + ' scan rows';\n  let outcome = 'ok';\n  if (actual !== c.expected) {\n    if (isAlert(c.expected) && !isAlert(actual)) outcome = 'missed';\n    else if (!isAlert(c.expected) && isAlert(actual)) outcome = 'false alarm';\n    else outcome = 'wrong result';\n  }\n  const r = rows[0] || {};\n  return { json: { run_id: runId, run_at: runAt, suite: 'detection', case_id: c.case_id, site_id: c.site_id, day: Number(c.day),\n    expected: c.expected, actual, passed: outcome === 'ok', outcome,\n    detail: [r.result, r.signal, r.note].filter(Boolean).join(' | ').slice(0, 400) } };\n});\n"
      },
